<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <radialGradient id="bg" cx="50%" cy="40%" r="75%">
      <stop offset="0%" stop-color="#1a1a1a"/>
      <stop offset="60%" stop-color="#0a0a0a"/>
      <stop offset="100%" stop-color="#000000"/>
    </radialGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f6e6a8"/>
      <stop offset="45%" stop-color="#d4af37"/>
      <stop offset="100%" stop-color="#8f6f1a"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#d4af37" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#d4af37" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="512" height="512" rx="96" fill="url(#bg)"/>

  <circle cx="256" cy="256" r="200" fill="url(#glow)"/>

  <g transform="translate(256 256)">
    <path d="M 0 -160 
             C 20 -60, 60 -20, 160 0 
             C 60 20, 20 60, 0 160 
             C -20 60, -60 20, -160 0 
             C -60 -20, -20 -60, 0 -160 Z"
          fill="url(#gold)"
          stroke="#f6e6a8"
          stroke-width="4"/>
  </g>

  <circle cx="256" cy="256" r="220" fill="none" stroke="#d4af37" stroke-width="2" stroke-opacity="0.3"/>
  <circle cx="256" cy="256" r="240" fill="none" stroke="#d4af37" stroke-width="1" stroke-opacity="0.15"/>
</svg>